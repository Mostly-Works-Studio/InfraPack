{
  "stack": "redis",
  "label": "Redis",
  "blurb": "In-memory data store · key/value, pub-sub, queues · RedisInsight UI",
  "category": "cache",
  "services": [
    {
      "name": "redis",
      "label": "Redis",
      "desc": "Redis {REDIS_VERSION}",
