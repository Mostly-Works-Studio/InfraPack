    }
  ],
  "settings": [
    {"key": "REDIS_PORT", "label": "Port", "type": "port", "group": "Redis"},
    {"key": "REDIS_VERSION", "label": "Image tag", "type": "text", "group": "Redis"},
    {"key": "REDIS_UI_PORT", "label": "Port", "type": "port", "group": "RedisInsight"},
    {"key": "REDIS_UI_VERSION", "label": "Image tag", "type": "text", "group": "RedisInsight"}
