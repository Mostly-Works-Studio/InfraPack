        {"label": "Host", "value": "localhost:{REDIS_PORT}", "copy": true},
        {"label": "URL", "value": "redis://localhost:{REDIS_PORT}", "copy": true},
        {"label": "In-network", "value": "redis:6379", "copy": true}
      ]
    },
    {
      "name": "redis-ui",
      "label": "RedisInsight",
      "ui": true,
