{
  "stack": "mssql",
  "label": "SQL Server",
  "blurb": "Microsoft SQL Server 2022 Developer · amd64 only, emulated on ARM machines",
  "category": "database",
  "services": [
    {
      "name": "mssql",
      "label": "SQL Server",
      "desc": "SQL Server {MSSQL_VERSION} · sa login",
      "facts": [
        {
          "label": "Host",
          "value": "localhost,{MSSQL_PORT}",
          "copy": true
        },
        {
          "label": "User",
          "value": "sa",
          "copy": true
        },
        {
          "label": "Password",
          "value": "{MSSQL_SA_PASSWORD}",
          "copy": true,
          "secret": true
        },
        {
          "label": "Connection",
          "value": "Server=localhost,{MSSQL_PORT};User Id=sa;Password={MSSQL_SA_PASSWORD};TrustServerCertificate=True",
          "copy": true,
          "secret": true
        },
        {
          "label": "JDBC",
          "value": "jdbc:sqlserver://localhost:{MSSQL_PORT};encrypt=true;trustServerCertificate=true",
          "copy": true
        },
        {
          "label": "In-network",
          "value": "mssql:1433",
          "copy": true
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "MSSQL_PORT",
      "label": "Port",
      "type": "port",
      "group": "SQL Server"
    },
    {
      "key": "MSSQL_SA_PASSWORD",
      "label": "sa password",
      "type": "secret",
      "group": "SQL Server",
      "note": "applied on first start only"
    },
    {
      "key": "MSSQL_VERSION",
      "label": "Image tag",
      "type": "text",
      "group": "SQL Server"
    }
  ],
  "platform": "linux/amd64"
}
